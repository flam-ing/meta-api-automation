# ============================================================
# Meta (Instagram, Facebook, Threads) Environment Variables
# ============================================================

# 1. Meta Official Graph API Credentials
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_APP_ACCESS_TOKEN=your_meta_app_id_here|your_meta_app_secret_here

# 2. Graph API Endpoint & Version
META_GRAPH_API_VERSION=v20.0
META_GRAPH_API_URL=https://graph.facebook.com/v20.0/

# 3. User & Entity IDs (Optional)
META_FB_USER_ID=your_facebook_user_id
META_IG_USER_ID=your_instagram_user_id
META_FB_PAGE_ID=your_facebook_page_id
THREADS_APP_ID=your_threads_app_id

# 4. Headless Automation Settings
META_CDP_PORT=9222
META_CHROME_PROFILE_DIR=~/.meta_chrome_profile
